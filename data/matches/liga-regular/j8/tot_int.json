  "commentary": [
    {
      "kind": "event",
      "minute": 5,
      "teamCode": "tot",
      "text": "R_Bentancur con un preciso pase hacia Richarlison H_Calhanoglu envía al delantero al suelo y el balón sale fuera de banda El asistente indica... Saque de banda",
